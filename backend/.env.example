# Backend - ejemplo de variables de entorno
# Copiar a backend/.env para desarrollo local. NO commitear .env con valores reales.

# -- Base de datos (MySQL local/dev) --
DB_USERNAME=root
DB_PASSWORD=your_db_password
# Producción: definir JDBC completo
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/monargent?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# -- Email --
# Proveedor: smtp (dev/local) o brevo (prod, HTTPS API). Default: smtp
APP_MAIL_PROVIDER=smtp

# SMTP (dev/local)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_google_app_password
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_FROM=noreply@monargent.app

# Brevo API (prod, requerido cuando APP_MAIL_PROVIDER=brevo)
# BREVO_API_KEY=your_brevo_api_key
# BREVO_SENDER_EMAIL=noreply@your-domain.com
# BREVO_SENDER_NAME=MonArgent
# BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# -- JWT (OBLIGATORIO) --
# Generar con: openssl rand -base64 64
JWT_SECRET=your_base64_jwt_secret_min_32_bytes

# -- OCR.Space (opcional según uso de escaneo) --
OCR_API_KEY=your_ocr_space_api_key

# -- Google Gemini (opcional según uso de IA) --
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest

# -- Frontend / CORS --
APP_FRONTEND_URL=http://localhost:5173
# Producción: orígenes exactos, separados por coma
CORS_ALLOWED_ORIGIN_PATTERNS=https://tu-dominio.com.ar,https://www.tu-dominio.com.ar

# -- Perfil --
# SPRING_PROFILES_ACTIVE=dev
